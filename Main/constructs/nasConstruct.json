{
    "run" : {
        "type" : "never"
    },
    "initRun" : [
        "sudo apt install -y samba samba-common-bin smbclient cifs-utils > /dev/null",
        "sudo mkdir -p $3 > /dev/null",
        "sudo bash -c \"echo -e '[$1]\ncomment = $2\npublic = yes\nwriteable = yes\nbrowsable = yes\npath = $3\nvalid users = $4' >> /etc/samba/smb.conf\" > /dev/null",
        "sudo useradd -m $4",
        "sudo smbpasswd -a $4",
        "sudo chmod -R 777 $3 > /dev/null",
        "sudo service smbd restart > /dev/null",
        "sudo systemctl enable --now smbd > /dev/null"
    ],
    "data" : {
        "initRun" : {
            "arguments" : [
                {
                    "name" : "name",
                    "type" : "string",
                    "comment" : "Name of SMB folder in file sharing apps",
                    "isNecesarry" : true,
                    "defaultValue" : ""
                },
                {
                    "name" : "comment",
                    "type" : "string",
                    "comment" : "String associated with share",
                    "isNecesarry" : true,
                    "defaultValue" : ""
                },
                {
                    "name" : "comment",
                    "type" : "string",
                    "comment" : "String associated with share",
                    "isNecesarry" : false,
                    "defaultValue" : "/mnt/NAS"
                },
                {
                    "name" : "username",
                    "type" : "string",
                    "comment" : "This will be the username you'll use to log into your NAS",
                    "isNecesarry" : false,
                    "defaultValue" : "Galena"
                }
            ]
        }
    }
}